<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="450" 
        Width="300">

    <StackPanel>
        
        <Label Content="Car Model" Width="200"/>
        <TextBox x:Name="Model" Width="200" Height="30" Margin="10"  Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Content="License Plate Model" Width="200"/>
        <TextBox x:Name="LicensePlate" Width="200" Height="30" Margin="10" Text="{Binding LicensePlate, UpdateSourceTrigger=PropertyChanged}"/>
        
        <Button x:Name="Submit" Content="Add Car" Width="200" Height="30" Margin="10" Command="{Binding AddCarCommand}"/>

        <!--ListBox -->
        <ListBox x:Name="ListBox" Width="200" Height="200" Margin="10" ItemsSource="{Binding Cars}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Model}" Margin="5"/>
                        <TextBlock Text="{Binding LicensePlate}" Margin="5"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
    </StackPanel>
</Window>
